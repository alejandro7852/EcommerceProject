@if (ViewBag.PagoRechazado == true)
{
    <div class="row p-5 mt-4 justify-content-center">
        <div class="col-sm-12 col-md-8 text-center">

            <i class="fa-solid fa-circle-xmark fa-10x text-danger mb-4"></i>

            <h1 class="text-danger">Pago rechazado</h1>

            <h4 class="text-dark-emphasis mb-4">
                No pudimos procesar tu pago.
            </h4>

            <div class="card shadow-sm mb-4">
                <div class="card-body">

                    <h5 class="card-title mb-4">
                        Detalle de la compra
                    </h5>

                    <div class="row text-start">

                        <div class="col-6 mb-3">
                            <strong>N° de orden</strong>
                            <br />
                            @ViewBag.OrdenId
                        </div>

                        <div class="col-6 mb-3">
                            <strong>Estado</strong>
                            <br />
                            <span class="badge bg-danger">
                                @ViewBag.Estado
                            </span>
                        </div>

                        <div class="col-6">
                            <strong>Monto</strong>
                            <br />
                            $@ViewBag.Monto
                        </div>

                        <div class="col-6">
                            <strong>Código de respuesta</strong>
                            <br />
                            @ViewBag.ResponseCode
                        </div>

                    </div>

                </div>
            </div>

            <div class="d-flex justify-content-center gap-3">
                <a class="btn btn-warning" href="/Home/Index">
                    Continuar comprando
                </a>

                <a class="btn btn-primary" href="/Home/VerCarro">
                    Volver al carrito
                </a>
            </div>

        </div>
    </div>
}
else
{
    <div class="row p-5 mt-4 justify-content-center">
    <div class="col-sm-12 col-md-8 text-center">

        <i class="fa-solid fa-circle-check fa-10x text-success mb-4"></i>

        <h1 class="text-success">¡Compra realizada!</h1>

        <h4 class="text-dark-emphasis mb-4">
            Tu pago fue procesado correctamente.
        </h4>

        <div class="card shadow-sm mb-4">
            <div class="card-body">

                <h5 class="card-title mb-4">Detalle de la compra</h5>

                <div class="row text-start">

                    <div class="col-6 mb-3">
                        <strong>N° de orden</strong>
                        <br />
                        @ViewBag.OrdenId
                    </div>

                    <div class="col-6 mb-3">
                        <strong>Estado</strong>
                        <br />
                        <span class="badge bg-success">
                            @ViewBag.Estado
                        </span>
                    </div>

                    <div class="col-6">
                        <strong>Monto pagado</strong>
                        <br />
                        $@ViewBag.Monto
                    </div>

                    <div class="col-6">
                        <strong>Orden de compra</strong>
                        <br />
                        @ViewBag.BuyOrder
                    </div>

                </div>

            </div>
        </div>

        <div class="d-flex justify-content-center gap-3">
            <a class="btn btn-warning" href="/Home/Index">
                Continuar comprando
            </a>

                <a class="btn btn-primary" href="/User/MisOrdenes">
                    Ir a mis compras
                </a>
        </div>

    </div>
</div>
}