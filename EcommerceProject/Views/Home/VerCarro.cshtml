@model List<CarroItemVM>

@if (Model.Count != 0)
{
    <div class="row justify-content-between mt-4">
        <div class="col-4">
            <h4>Productos del Carro</h4>
        </div>
        <div class="col-4 text-end">
            <button class="btn btn-success">Comprar</button>
        </div>
    </div>
    <hr />

    <table class="table table-striped">
        <thead>
            <tr>
                <th style="width:150px"></th>
                <th>Nombre</th>
                <th>Precio</th>
                <th>Cantidad</th>
                <th>Total</th>
            </tr>

        </thead>

        <tbody>
            @foreach (var item in Model)
            {
                <tr class="align-middle">
                    <td style="width:150px">
                        <img class="card-img-top rounded" src="~/images/@item.ImagenNombre" alt="Imagen" loading="lazy" style="width:100px" />
                    </td>
                    <td>@item.Nombre</td>
                    <td>@item.Precio.ToString("C2")</td>
                    <td>@item.Cantidad</td>
                    <td>@((@item.Precio * @item.Cantidad).ToString("C2"))</td>

                    <td style="width:150px">
                        <a href="/Home/EliminarProductoCarro?productoId=@item.ProductoId" class="btn btn-sm btn-danger">
                            <i class="fa-solid fa-xmark"></i>
                        </a>

                    </td>
                </tr>
            }
        </tbody>

    </table>


}
else
{
    <div class="alert alert-warning mt-3" role="alert">
        Sin productos agregados al carro.
    </div>
}