@{
    ViewData["Title"] = "Inicio";
}

<div class="container py-5">

    <div class="p-5 mb-5 bg-primary text-white rounded-4 shadow text-center">
        <h1 class="display-4 fw-bold">🛍️ Bienvenido a Mi Ecommerce</h1>
        <p class="lead mt-3">
            Encuentra los mejores productos con la mejor calidad y al mejor precio.
        </p>

        <a asp-controller="Producto" asp-action="Index" class="btn btn-light btn-lg mt-3">
            Ver Productos
        </a>
    </div>

    <div class="row g-4">

        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body text-center">
                    <h1>🚚</h1>
                    <h4>Envío Rápido</h4>
                    <p class="text-muted">
                        Despachamos tus compras de forma rápida y segura.
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body text-center">
                    <h1>💳</h1>
                    <h4>Pago Seguro</h4>
                    <p class="text-muted">
                        Compra con confianza utilizando métodos de pago seguros.
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body text-center">
                    <h1>⭐</h1>
                    <h4>Calidad Garantizada</h4>
                    <p class="text-muted">
                        Seleccionamos productos de excelente calidad para nuestros clientes.
                    </p>
                </div>
            </div>
        </div>

    </div>

    <div class="text-center mt-5">
        <h2>Comienza a explorar</h2>
        <p class="text-muted">
            Navega por nuestras categorías y descubre ofertas increíbles.
        </p>

        <a asp-controller="Categoria" asp-action="Index" class="btn btn-outline-primary me-2">
            Categorías
        </a>


    </div>

</div>