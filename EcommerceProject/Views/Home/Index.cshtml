@model CatalogoVM;
@{
    ViewData["Title"] = "Inicio";
}

<div class="container py-5">

    <div class="p-5 mb-5 bg-primary text-white rounded-4 shadow text-center">
        <h1 class="display-4 fw-bold"><i class="fa-brands fa-shopify"></i> Bienvenido a Mi Ecommerce</h1>
        <p class="lead mt-3">
            Encuentra los mejores productos con la mejor calidad y al mejor precio.
        </p>
        <div class="row p-5 bg-primary mt-4">
            <div class="col-sm-12 col-md-3 col-lg-3">
                <div class="d-grid">
                    <!-- Button trigger modal -->
                    <button type="button" class="btn btn-success" data-bs-toggle="modal" data-bs-target="#exampleModal">
                        Categorías
                    </button>
                </div>
            </div>

            <div class="col-sm-12 col-md-9 col-lg-9">
                <form asp-controller="Home" asp-action="FiltrarPorBusqueda" method="post">
                    <div class="input-group">

                        <input type="text" class="form-control" autocomplete="off" name="busqueda" placeholder="¿Qué Estás Buscando?" />
                        <button class="btn btn-secondary bg-secondary" type="submit"><i class="fa-solid fa-magnifying-glass"></i> </button>


                    </div>
                </form>
            </div>

        </div>



    </div>
    @if (Model.filtro != "" && Model.filtro != null)
    {
        <div class="row bg-light p-2 mt-2">
            <div class="col-sm-12">
                @Model.filtro
            </div>
        </div>
    }
    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-4 g-4 py-4">
        @foreach (var p in Model.Productos)
        {
            <div class="col">
                <div class="card shadow-sm">
                    <img class="card-img-top" src="~/images/@p.NombreImagen" alt="..." />
                    <div class="card-body p-4">
                        <div class="text-center">
                            <h5 class="fw-bolder">@p.Nombre</h5>
                            @p.Precio.ToString("C2")
                        </div>
                    </div>
                    <div class="card-footer p-4 pt-0 border-0 bg-transparent">
                        <div class="text-center">
                            <a class="btn btn-outline-dark mt-auto" role="button" href="/Home/ProductoDetalle?id=@p.ProductoId">Ver detalle</a>
                        </div>
                    </div>
                </div>
            </div>

        }
    </div>



</div>


<!-- Modal -->
<div class="modal fade" id="exampleModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel">Categorías</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>

            </div>

            <div class="modal-body">

                <div class="row row-cols-2 g-2">
                    <div class="col d-grid">
                        <a class="btn btn-outline-dark"
                           asp-controller="Home" asp-action="FiltrarPorCategoria" asp-route-id="0" asp-route-nombre=""> Todas</a>
                    </div>
                    @foreach (var categoria in Model.Categorias)
                    {
                        <div class="col d-grid">
                            <a class="btn btn-outline-dark"
                               asp-controller="Home" asp-action="FiltrarPorCategoria"
                               asp-route-id="@categoria.CategoriaId" asp-route-nombre="@categoria.Nombre">
                                @categoria.Nombre
                            </a>
                        </div>
                    }
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>


