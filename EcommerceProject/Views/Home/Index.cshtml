@model CatalogoVM;
@{
    ViewData["Title"] = "Inicio";
}

<div class="container py-5">

    <div class="p-5 mb-5 bg-primary text-white rounded-4 shadow text-center">
        <h1 class="display-4 fw-bold"><i class="fa-brands fa-shopify"></i> Bienvenido a Mi Ecommerce</h1>
        <p class="lead mt-3">
            Encuentra los mejores productos con la mejor calidad y al mejor precio.
        </p>
        <div class="row p-5 bg-primary mt-4">
            <div class="col-sm-12 col-md-3 col-lg-3">
                <div class="d-grid">
                    <!-- Button trigger modal -->
                    <button class="btn btn-success"
                            type="button"
                            data-bs-toggle="offcanvas"
                            data-bs-target="#categoriasOffcanvas">
                        <i class="fas fa-tags me-1"></i>

                        Categorías
                    </button>
                </div>
            </div>

            <div class="col-sm-12 col-md-9 col-lg-9">
                <form asp-controller="Home" asp-action="FiltrarPorBusqueda" method="post">
                    <div class="input-group">

                        <input type="text" class="form-control" autocomplete="off" name="busqueda" placeholder="¿Qué Estás Buscando?" />
                        <button class="btn btn-secondary bg-secondary" type="submit"><i class="fa-solid fa-magnifying-glass"></i> </button>


                    </div>
                </form>
            </div>

        </div>



    </div>
    @if (!string.IsNullOrEmpty(Model.filtro))
    {
        <span>@Model.filtro</span>
    }
   
    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-4 g-4 py-4">
        @foreach (var p in Model.Productos)
        {
            <div class="col">
                <div class="card shadow-sm">
                    <img class="card-img-top" src="~/images/@p.NombreImagen" alt="..." />
                    <div class="card-body p-4">
                        <div class="text-center">
                            <h5 class="fw-bolder">@p.Nombre</h5>
                            @p.Precio.ToString("C2")
                        </div>
                    </div>
                    <div class="card-footer p-4 pt-0 border-0 bg-transparent">
                        <div class="text-center">
                            <a class="btn btn-outline-dark mt-auto" role="button" href="/Home/ProductoDetalle?id=@p.ProductoId">Ver detalle</a>
                        </div>
                    </div>
                </div>
            </div>

        }
    </div>



</div>


<!-- Modal -->
<div class="offcanvas offcanvas-start" tabindex="-1" id="categoriasOffcanvas">

    <div class="offcanvas-header border-bottom">
        <h5 class="offcanvas-title fw-bold">
            <i class="fas fa-tags me-2"></i>
            Categorías
        </h5>

        <button type="button"
                class="btn-close"
                data-bs-dismiss="offcanvas"
                aria-label="Cerrar">
        </button>
    </div>

    <div class="offcanvas-body p-0">

        <div class="list-group list-group-flush">

            <!-- Todas -->
            <a class="list-group-item list-group-item-action py-3"
               asp-controller="Home"
               asp-action="FiltrarPorCategoria"
               asp-route-id="0"
               asp-route-nombre="">

                <i class="fas fa-border-all me-2"></i>
                Todas
            </a>

            @foreach (var categoria in Model.Categorias)
            {
                <a class="list-group-item list-group-item-action py-3"
                   asp-controller="Home"
                   asp-action="FiltrarPorCategoria"
                   asp-route-id="@categoria.CategoriaId"
                   asp-route-nombre="@categoria.Nombre">

                    <i class="fas fa-tag me-2"></i>
                    @categoria.Nombre
                </a>
            }

        </div>

    </div>

</div>



