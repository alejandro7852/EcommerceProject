@model ErrorViewModel
@{
    ViewData["Title"] = "Error general";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6 text-center">

            <div class="mb-4">
                <div class="display-1 text-danger fw-bold mb-2">
                    <i class="bi bi-exclamation-octagon-fill"></i> 500
                </div>
                <h1 class="h3 text-dark fw-semibold">¡Ups! Algo salió mal</h1>
                <p class="text-muted fs-6">
                    Ocurrió un error inesperado al procesar tu solicitud. Nuestro equipo ya ha sido notificado.
                </p>
            </div>

            @if (Model.ShowRequestId)
            {
                <div class="card bg-light border-0 rounded-3 mb-4 text-start">
                    <div class="card-body p-3 d-flex align-items-center justify-content-between">
                        <div>
                            <span class="text-uppercase text-muted fw-bold small d-block">Request ID</span>
                            <code class="text-danger fs-6">@Model.RequestId</code>
                        </div>
                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1">
                            Tracking
                        </span>
                    </div>
                </div>
            }

            <div class="d-flex justify-content-center gap-2 mb-5">
                <a href="javascript:history.back()" class="btn btn-outline-secondary px-4">
                    <i class="bi bi-arrow-left me-1"></i> Volver atrás
                </a>
                <a asp-controller="Home" asp-action="Index" class="btn btn-primary px-4">
                    <i class="bi bi-house-door me-1"></i> Ir al Inicio
                </a>
            </div>

            
            

        </div>
    </div>
</div>